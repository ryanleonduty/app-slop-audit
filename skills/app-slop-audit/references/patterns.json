{
  "name": "app-slop-audit-patterns",
  "version": 2,
  "description": "Machine-readable pattern catalog. Single source of truth for the scoring weights and the pattern-id register. Consumed by scripts/score_slop.py and referenced by references/slop-patterns.md (the human prose catalog).",
  "severity_weights": {
    "CRITICAL": 5.0,
    "HIGH": 3.0,
    "MEDIUM": 1.5,
    "LOW": 0.5
  },
  "category_weights": {
    "color": 1.4,
    "typography": 1.3,
    "layout": 1.3,
    "controls": 1.2,
    "content": 1.2,
    "material": 1.1,
    "state": 1.1,
    "icon": 1.0,
    "motion": 1.0,
    "accessibility": 1.6
  },
  "evidence_weights": {
    "code": 1.0,
    "screenshot": 0.8,
    "combined": 1.15
  },
  "scoring": {
    "ceiling": 45.0,
    "count_reference": 20,
    "count_boost": 4.0,
    "ceiling_note": "100 maps to ~45 category-weighted units. A uniformly medium-sloppy app across all 10 categories at confirmed evidence totals ~21 units (~47 index); the top of the scale is reserved for escalating CRITICAL/HIGH density, so a broadly-sloppy-but-not-catastrophic app lands mid-to-upper NOTICEABLE..SEVERE instead of saturating."
  },
  "patterns": [
    { "id": "type-flat-scale",                 "category": "typography", "severity": "HIGH",     "title": "Flat type scale" },
    { "id": "bold-as-only-emphasis",           "category": "typography", "severity": "MEDIUM",   "title": "Bold-as-only-emphasis" },
    { "id": "serif-for-creative-autopilot",    "category": "typography", "severity": "MEDIUM",   "title": "Serif-for-creative autopilot" },
    { "id": "monospace-misuse",                "category": "typography", "severity": "LOW",      "title": "Monospace misuse" },
