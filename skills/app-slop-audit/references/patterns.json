    { "id": "hardcoded-light-only-colors",     "category": "color",      "severity": "CRITICAL", "title": "Hardcoded light-only colors" },
    { "id": "warm-beige-premium-autopilot",    "category": "color",      "severity": "HIGH",     "title": "Warm-beige premium autopilot" },
    { "id": "background-gradient-slop",        "category": "color",      "severity": "MEDIUM",   "title": "Background gradient slop" },
    { "id": "ios-default-system-blue-tint",    "category": "color",      "severity": "HIGH",     "title": "iOS default system-blue tint" },
